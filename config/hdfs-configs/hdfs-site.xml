
<!-- hdfs-site.xml -->
<configuration>

  <!-- Set replication factor -->
  <property>
    <name>dfs.replication</name>
    <value>3</value>
  </property>

  <!-- NameNode storage directory -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>./namenode_data:/opt/hadoop/data/name</value>
  </property>

  <!-- DataNode storage directory -->
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>./datanode1_data:/opt/hadoop/data/data</value>
  </property>

  <property>
    <name>dfs.datanode.data.dir</name>
    <value>./datanode2_data:/opt/hadoop/data/data</value>
  </property>

  <property>
    <name>dfs.datanode.data.dir</name>
    <value>./datanode3_data:/opt/hadoop/data/data</value>
  </property>

  <!-- Set HDFS block size -->
  <property>
    <name>dfs.blocksize</name>
    <value>4194304</value>
    <description>Block size in bytes. Set to 4MB for educational purpose.</description>
  </property>

</configuration>
