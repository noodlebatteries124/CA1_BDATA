FROM apache/hadoop:3.5.0

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-venv \
    && python3 -m venv /opt/mrjob-venv \
    && /opt/mrjob-venv/bin/pip install --no-cache-dir mrjob==0.7.4 PyYAML==6.0.2 setuptools==75.8.0 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/mrjob-venv/bin:${PATH}"
